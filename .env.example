# Chronomail — variables d'environnement
# ============================================================
# Copier en `.env` et renseigner. Le `.env` n'est jamais commité.
#
# En production, ces valeurs vivent dans Render → Environment,
# et nulle part ailleurs.
#
# Les variables marquées OBLIGATOIRE font échouer le démarrage du
# serveur si elles manquent : c'est délibéré, un défaut silencieux
# coûte plus cher qu'un crash au boot.


# ── Base de données ─────────────────────────────────────────
# OBLIGATOIRE. En local, le conteneur Docker de dev (cf. README) :
DATABASE_URL="postgresql://chronomail:chronomail_dev_local@localhost:5433/chronomail_dev"


# ── Application ─────────────────────────────────────────────
# OBLIGATOIRE. URL publique : origine CORS, URL de retour Stripe et
# base de tous les liens d'emails. Doit être absolue (http/https),
# sans slash final. Une valeur fausse ne lève aucune erreur à
# l'exécution — elle envoie juste les clients au mauvais endroit.
APP_URL="http://localhost:3000"

# OBLIGATOIRE. Secret de signature des JWT. Aucun défaut : un secret
# présent dans le code source permettrait de forger un token pour
# n'importe quel compte. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Facultatif (défaut 3000).
PORT=3000

# Facultatif. Base des URL de GIF si le reverse proxy ne renvoie pas
# le bon protocole/hôte. À défaut, reconstruite depuis la requête.
BASE_URL="http://localhost:3000"


# ── Emails (Resend) ─────────────────────────────────────────
# Sans clé, aucun email n'est envoyé : les tentatives sont loguées
# `[EMAIL SKIP]` et le serveur continue de tourner normalement.
RESEND_API_KEY=""

# Expéditeur. Le domaine doit être vérifié dans Resend, sinon les
# messages partent sans jamais être délivrés.
MAIL_FROM="Chronomail <noreply@chrono-mail.app>"

# Console d'assistance : liste blanche d'emails, séparés par des
# virgules. Vide = personne n'est admin (fail-closed).
ADMIN_EMAILS=""

# Destinataire des alertes de nouveau ticket. À défaut, la première
# adresse d'ADMIN_EMAILS.
SUPPORT_EMAIL=""


# ── Authentification Google (OAuth) ─────────────────────────
# Facultatif : sans ces valeurs, seule la connexion par mot de passe
# fonctionne.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"


# ── Paiements (Stripe) ──────────────────────────────────────
STRIPE_SECRET_KEY=""
# Secret de signature du webhook. Sans lui, tout événement entrant
# est rejeté en 400 — c'est le seul rempart de cette route.
STRIPE_WEBHOOK_SECRET=""

# Identifiants de tarifs (price_...), pas les produits.
STRIPE_PRO_PRICE_MONTHLY=""
STRIPE_PRO_PRICE_YEARLY=""
STRIPE_BUSINESS_PRICE_MONTHLY=""
STRIPE_BUSINESS_PRICE_YEARLY=""


# ── Jobs planifiés ──────────────────────────────────────────
# EN LOCAL, GARDER `true` : une machine de dev branchée sur la base de
# production enverrait de vraies relances et lancerait de vraies purges.
DISABLE_CRON=true

# Facultatifs — valeurs par défaut entre parenthèses.
CRON_TIMEZONE="Europe/Paris"
# CRON_ACTIVATION_NUDGE="0 10 * * *"      # relance activation (48h)
# CRON_WINBACK="15 10 * * *"              # win-back (14 jours)
# CRON_REACTIVATION="30 10 * * *"         # réactivation (30 jours)
# CRON_PURGE_IMPRESSIONS="45 3 * * *"     # purge impressions (12 mois)
# CRON_PURGE_TICKETS="0 4 * * *"          # purge tickets de support


# ── Développement ───────────────────────────────────────────
# Ouvre /email-preview, qui expose tous les templates d'emails.
# JAMAIS en production : la route est publique une fois activée.
EMAIL_PREVIEW=true

# Facultatif. Ne pilote que le niveau de log Prisma, la réutilisation
# du client entre rechargements et le détail des erreurs de polices.
# Aucune garde de sécurité ne doit en dépendre : son absence sur
# l'hébergeur a déjà laissé une route de debug ouverte en production.
# NODE_ENV="development"
