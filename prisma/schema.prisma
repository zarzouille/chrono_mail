generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  password String
  plan     Plan    @default(FREE)

  emailVerified    Boolean @default(false)
  emailVerifyToken String?

  quotaNotified    Boolean @default(false)
  activationNudged Boolean @default(false)

  // Rétention — remis à zéro à chaque connexion (cf. lib/retention.js)
  lastLoginAt          DateTime?
  winbackNotified      Boolean   @default(false)
  reactivationNotified Boolean   @default(false)

  // Emails marketing (relances de rétention) — les transactionnels ignorent ce flag
  marketingOptOut  Boolean @default(false)
  unsubscribeToken String? @unique

  resetToken       String?
  resetTokenExpiry DateTime?

  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countdowns  Countdown[]
  impressions Impression[]
}

model Countdown {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  endDate  DateTime
  timezone String   @default("Europe/Paris")

  bgColor   String @default("#ffffff")
  textColor String @default("#2563eb")
  fontSize  Int    @default(36)
  width     Int    @default(400)

  // Apparence (Free)
  fontFamily  String @default("monospace")
  style       String @default("rounded")
  orientation String @default("horizontal")

  // Unités affichées — ex: "days,hours,minutes,seconds"
  showUnits String @default("days,hours,minutes,seconds")

  // Labels personnalisés (Pro)
  labelDays    String @default("JOURS")
  labelHours   String @default("HEURES")
  labelMinutes String @default("MIN")
  labelSeconds String @default("SEC")

  // Post-expiration
  expiredBehavior ExpiredBehavior @default(SHOW_ZEROS)
  expiredText     String?
  expiredRedirect String?

  // Affichage des séparateurs « : » entre les blocs. Non restreint par
  // plan, contrairement à sepColor qui n'en fixe que la couleur.
  showSeparators Boolean @default(true)

  // Apparence avancée (Pro)
  blockBgColor String?
  fontLabels   String?
  sepColor     String?

  // Image de fond (Pro)
  bgImageUrl String?

  // Timer perpétuel (Business)
  perpetual        Boolean @default(false)
  perpetualSeconds Int     @default(86400)

  // Notification expiration envoyée
  expiredNotified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  impressions Impression[]

  @@index([userId])
}

model Impression {
  id          String    @id @default(cuid())
  countdownId String
  countdown   Countdown @relation(fields: [countdownId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Volontairement réduit au strict nécessaire : ni IP ni User-Agent.
  // Le GIF est chargé par les destinataires des campagnes de nos clients,
  // et ces champs n'alimentaient aucune fonctionnalité.
  createdAt DateTime @default(now())

  @@index([countdownId])
  @@index([userId])
  @@index([createdAt])
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum ExpiredBehavior {
  SHOW_ZEROS
  SHOW_TEXT
  REDIRECT
}
