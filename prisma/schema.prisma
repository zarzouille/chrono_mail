generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  password String
  plan     Plan    @default(FREE)

  emailVerified    Boolean @default(false)
  emailVerifyToken String?

  quotaNotified    Boolean @default(false)
  activationNudged Boolean @default(false)

  // Rétention — remis à zéro à chaque connexion (cf. lib/retention.js)
  lastLoginAt          DateTime?
  winbackNotified      Boolean   @default(false)
  reactivationNotified Boolean   @default(false)

  // Emails marketing (relances de rétention) — les transactionnels ignorent ce flag
  marketingOptOut  Boolean @default(false)
  unsubscribeToken String? @unique

  resetToken       String?
  resetTokenExpiry DateTime?

  // Révocation des JWT déjà émis. Un jeton signé avant cette date est
  // refusé, même si le compte existe toujours : sans ce champ, un jeton
  // volé restait valable jusqu'à sept jours après que ses identifiants
  // aient été invalidés. Null = aucune révocation, tous les jetons valent.
  sessionsValidFrom DateTime?

  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countdowns  Countdown[]
  impressions Impression[]
  tickets     SupportTicket[]
}

model Countdown {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  endDate  DateTime
  timezone String   @default("Europe/Paris")

  bgColor   String @default("#ffffff")
  textColor String @default("#2563eb")
  fontSize  Int    @default(36)
  width     Int    @default(400)

  // Apparence (Free)
  fontFamily  String @default("monospace")
  style       String @default("rounded")
  orientation String @default("horizontal")

  // Unités affichées — ex: "days,hours,minutes,seconds"
  showUnits String @default("days,hours,minutes,seconds")

  // Labels personnalisés (Pro)
  labelDays    String @default("JOURS")
  labelHours   String @default("HEURES")
  labelMinutes String @default("MIN")
  labelSeconds String @default("SEC")

  // Post-expiration
  expiredBehavior ExpiredBehavior @default(SHOW_ZEROS)
  expiredText     String?
  expiredRedirect String?

  // Affichage des séparateurs « : » entre les blocs. Non restreint par
  // plan, contrairement à sepColor qui n'en fixe que la couleur.
  showSeparators Boolean @default(true)

  // Apparence avancée (Pro)
  blockBgColor String?
  fontLabels   String?
  sepColor     String?

  // Image de fond (Pro)
  bgImageUrl String?

  // Timer perpétuel (Business)
  perpetual        Boolean @default(false)
  perpetualSeconds Int     @default(86400)

  // Notification expiration envoyée
  expiredNotified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  impressions Impression[]

  @@index([userId])
}

model Impression {
  id          String    @id @default(cuid())
  countdownId String
  countdown   Countdown @relation(fields: [countdownId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Volontairement réduit au strict nécessaire : ni IP ni User-Agent.
  // Le GIF est chargé par les destinataires des campagnes de nos clients,
  // et ces champs n'alimentaient aucune fonctionnalité.
  createdAt DateTime @default(now())

  @@index([countdownId])
  @@index([userId])
  @@index([createdAt])
}

/// Demande de support déposée depuis la page Contact.
///
/// Le ticket est rattaché au compte quand la demande vient d'un utilisateur
/// connecté, mais `userId` reste optionnel : un client qui n'arrive plus à se
/// connecter — cas de support fréquent — doit pouvoir écrire quand même.
/// `email` est donc la seule voie de réponse garantie, et n'est pas déduit du
/// compte : on stocke l'adresse effectivement saisie.
model SupportTicket {
  id     String  @id @default(cuid())
  ref    String  @unique // Référence lisible communiquée au client (ex. CM-7X4K2Q)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email String
  name  String?

  category TicketCategory @default(OTHER)
  subject  String
  status   TicketStatus   @default(OPEN)

  // Plan au moment de la demande : le plan courant de l'utilisateur peut
  // avoir changé quand on traite le ticket (upgrade, fin d'abonnement),
  // or c'est bien le contexte de la demande qui aide à la comprendre.
  planAtCreation Plan?

  // Date du dernier message, quel qu'en soit l'auteur — sert au tri de la
  // file d'attente, là où updatedAt bouge aussi sur un simple changement
  // de statut ou de catégorie.
  lastMessageAt DateTime @default(now())
  resolvedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  @@index([status, category])
  @@index([userId])
  @@index([lastMessageAt])
}

/// Un message dans le fil d'un ticket, du client ou du support.
model SupportMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  author TicketAuthor
  body   String

  createdAt DateTime @default(now())

  @@index([ticketId])
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum TicketCategory {
  TECHNICAL // Problème technique / aide à l'utilisation
  BILLING   // Facturation, abonnement, remboursement
  PRIVACY   // Droits RGPD
  BUG       // Signalement de bug
  FEATURE   // Suggestion de fonctionnalité
  OTHER
}

enum TicketStatus {
  OPEN     // Reçu ou relancé par le client — à traiter
  PENDING  // Réponse envoyée, en attente du client
  RESOLVED // Traité
  CLOSED   // Clos sans suite
}

enum TicketAuthor {
  CUSTOMER
  SUPPORT
}

enum ExpiredBehavior {
  SHOW_ZEROS
  SHOW_TEXT
  REDIRECT
}
